# Opens the keys saved on the Settings page; the same 64 hex characters as
# the engine's AURO_SECRETS_KEY (openssl rand -hex 32).
export AURO_SECRETS_KEY=
# These can be saved on the Settings page instead (a saved value wins).
export OANDA_API_KEY=
export OANDA_ACCOUNT_ID=
export OANDA_BASE_URL=
export AURO_BASE_URL=
export DISCORD_WEBHOOK_URL=
