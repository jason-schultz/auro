DATABASE_URL=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com
FMP_API_KEY=
FMP_BASE_URL=
HOST=127.0.0.1
PORT=3000

# Questrade: only to seed the first start (the engine then saves each rotated
# token itself). If Questrade rejects the saved token later, paste a new one on
# Opus's Accounts page instead of editing this and restarting.
# QUESTRADE_REFRESH_TOKEN=

# Massive (formerly Polygon.io) market data: US equity daily bars.
MASSIVE_CALLS_PER_MINUTE=5
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# The tester (cargo run --release --bin auro-tester): its own port, never PORT.
# AURO_TESTER_PORT=3001
# Postgres connections per process (defaults 5 live, 10 tester).
# AURO_LIVE_DB_POOL_SIZE=5
# AURO_TESTER_DB_POOL_SIZE=10
