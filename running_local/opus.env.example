# Copy to running_local/opus.env and fill in. opus.env is git-ignored.
# Read by bin/opus-start; plain KEY=value lines.

PHX_SERVER=true
PHX_HOST=localhost
PORT=4321
POOL_SIZE=20

# mix phx.gen.secret
SECRET_KEY_BASE=

DATABASE_URL=ecto://postgres:postgres@localhost:5432/auro

OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=
OANDA_API_KEY=

AURO_BASE_URL=http://localhost:3000

# Discord channel webhook for alerts (channel settings → Integrations →
# Webhooks → Copy Webhook URL). Leave empty to send nothing.
DISCORD_WEBHOOK_URL=
