#!/bin/zsh
# Starts the Opus release in the foreground for launchd (com.auro.opus).
set -euo pipefail

here=${0:A:h:h}
release=$here/../opus/_build/prod/rel/opus/bin/opus

if [[ ! -f $here/opus.env ]]; then
  print -u2 "opus-start: missing $here/opus.env (copy opus.env.example)"
  exit 1
fi

set -a
source $here/opus.env
set +a

exec $release start
